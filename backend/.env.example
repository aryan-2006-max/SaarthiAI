# ==========================================
# SaarthiAI Backend Environment Template
# ==========================================
PORT=5000
NODE_ENV=production

# Database (MongoDB Atlas)
DATABASE_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/saarthiai

# Authentication
JWT_SECRET=your_secure_jwt_secret_here
JWT_EXPIRE=30d

# Live Bus Tracking API Key (Open Transit Data Delhi / GTFS Realtime)
BUS_TRACKING_API_KEY=otd_live_your_delhi_bus_api_key_here
OTD_DELHI_API_KEY=otd_live_your_delhi_bus_api_key_here

# Google Gemini / OpenAI API Key
AI_API_KEY=AIzaSyYourGoogleGeminiApiKeyHere
GEMINI_API_KEY=AIzaSyYourGoogleGeminiApiKeyHere

# Google Maps Platform API Key
MAPS_API_KEY=AIzaSyYourGoogleMapsApiKeyHere
GOOGLE_MAPS_API_KEY=AIzaSyYourGoogleMapsApiKeyHere

# OpenWeatherMap API Key
WEATHER_API_KEY=your_openweather_api_key_here
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
